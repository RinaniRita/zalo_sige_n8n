# ─── Hướng dẫn ───────────────────────────────────────────────────────────────
# Copy file này thành .env và điền các giá trị thật vào:
#   cp .env.example .env


# ─── n8n Docker ───────────────────────────────────────────────────────────────
# URL public của bạn (ngrok hoặc domain thật) để Zalo gọi được Webhook
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app
SUBDOMAIN=your-ngrok-url.ngrok-free.app
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh


# ─── Zalo OA ─────────────────────────────────────────────────────────────────
# Lấy từ https://developers.zalo.me → App của bạn → Settings
ZALO_APP_ID=your_zalo_app_id
ZALO_SECRET_KEY=your_zalo_secret_key

# Lấy từ Zalo OA Manager → Official Account → Access Token
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token


# ─── n8n Webhook (Bot → n8n) ─────────────────────────────────────────────────
# Giữ nguyên nếu bot chạy local và n8n chạy Docker trên cùng máy
N8N_WEBHOOK_URL=http://localhost:5678/webhook/zalo-internal


# ─── Google Sheets ───────────────────────────────────────────────────────────
# ID của Google Sheet lưu Lead (lấy từ URL của Sheet)
GOOGLE_SHEET_ID=your_google_sheet_id


# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Lấy từ https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-...

# (Tuỳ chọn) Gemini API Key nếu cần dùng Google AI
GEMINI_API_KEY=AIza...
